# Base URL the API client prefixes every request with. Defaults to /api if unset.
VITE_API_URL=http://localhost:8080/api

# Set to "disabled" once Codex — Backend's Identity endpoints are live and you want
# to hit the real API in local dev instead of the MSW mocks in src/mocks/handlers.ts.
VITE_API_MOCKING=enabled
