# Copy this file to .env and fill in real local-dev values.
# .env is gitignored — never commit real secrets.

# Postgres password for the docker-compose "postgres" service and the API's
# connection string.
POSTGRES_PASSWORD=

# HMAC signing key for JWT issuance. Must be at least 32 UTF-8 bytes.
# Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=
